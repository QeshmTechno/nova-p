{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-p",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "a4b1d73f-e38b-4ede-a557-89c0311e5202","database_name": "nova-p" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "35c2bf746a254d11b13529193cf59933" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
